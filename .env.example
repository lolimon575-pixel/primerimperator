# Default remains a demonstration. No orders are sent to the restaurant.
ORDER_MODE=demo
ORDER_APP_ORIGIN=https://primerimperator.onrender.com
# Generate a unique value of at least 24 characters; never commit it.
ORDER_ADMIN_PASSWORD=
ORDER_RATE_LIMIT_SECRET=

# Live acceptance requires a persistent volume, backup process and authorization
# from the restaurant, plus the configuration below. No live service is enabled
# by this example. The demo database is temporary and contains fictional data.
ORDER_DATABASE_PATH=
ORDER_STORAGE_DURABLE=0
# 32 random bytes encoded as 64 hexadecimal characters; back up securely.
ORDER_ENCRYPTION_KEY=
